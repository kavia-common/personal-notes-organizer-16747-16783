---
import { store } from "../lib/store";
const palette = {
  primary: "#1e88e5",
  secondary: "#1565c0",
  accent: "#ffd600",
};
---

<header class="topbar card">
  <div class="inner">
    <div class="left">
      <div class="logo" aria-label="Notes">
        <span class="dot" />
        <strong>Notes</strong>
      </div>
      <div class="search-wrap">
        <input id="top-search" class="input" placeholder="Search notes, tags..." />
      </div>
    </div>

    <div class="right">
      <div id="auth-area"></div>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: saturate(1.2) blur(8px);
    background: linear-gradient(180deg, #ffffff, #f9fbff);
    border: none;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
    box-shadow: none;
  }
  .inner {
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 16px;
    gap: 12px;
  }
  .left { display: flex; align-items: center; gap: 12px; flex: 1; }
  .right { display: flex; align-items: center; gap: 12px; }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    letter-spacing: 0.3px;
  }
  .logo .dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: linear-gradient(180deg, {palette.accent}, #ffcc00);
    box-shadow: 0 0 0 3px rgba(255,214,0,0.2);
  }

  .search-wrap { flex: 1; max-width: 660px; }
  #top-search {
    background: #fff;
    border: 1px solid var(--border);
    padding: 10px 12px;
  }

  .profile {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 6px 10px; border-radius: 999px;
    border: 1px solid var(--border);
    background: #fff;
  }
  .avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: linear-gradient(180deg, {palette.primary}, {palette.secondary});
    color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 700;
    box-shadow: 0 4px 10px rgba(21,101,192,0.25);
  }
  .name { color: var(--text); }
  .email { color: var(--muted); font-size: 12px; }
  .stack { display: flex; flex-direction: column; line-height: 1.1; }

  .btn {
    padding: 8px 12px;
  }

  @media (max-width: 840px) {
    .search-wrap { display: none; }
  }
</style>

<script>
  import { store } from "../lib/store";

  const elSearch = document.getElementById("top-search");
  const authArea = document.getElementById("auth-area");

  function renderAuth() {
    const state = store.getState();
    if (!authArea) return;
    if (state.user) {
      const initials = state.user.name.trim().split(/\s+/).map(s => s[0]).slice(0,2).join("").toUpperCase();
      authArea.innerHTML = `
        <div class="profile">
          <div class="avatar" title="${state.user.name}">${initials || "U"}</div>
          <div class="stack">
            <span class="name">${state.user.name}</span>
            <span class="email">${state.user.email}</span>
          </div>
          <button class="btn btn-ghost" id="logout-btn">Logout</button>
        </div>
      `;
      const btn = document.getElementById("logout-btn");
      btn?.addEventListener("click", () => store.logout());
    } else {
      authArea.innerHTML = `
        <button class="btn btn-primary" id="login-btn">Sign in</button>
      `;
      const btn = document.getElementById("login-btn");
      btn?.addEventListener("click", () => {
        const name = prompt("Your name:");
        if (!name) return;
        const email = prompt("Email:");
        if (!email) return;
        store.login(name, email);
      });
    }
  }

  function handleSearchInput() {
    const q = elSearch?.value || "";
    store.setSearch(q);
  }

  if (elSearch) {
    elSearch.value = store.getState().search;
    elSearch.addEventListener("input", handleSearchInput);
  }
  renderAuth();

  store.subscribe(() => {
    // sync search input if it changed elsewhere
    const s = store.getState().search;
    if (elSearch && elSearch.value !== s) elSearch.value = s;
    renderAuth();
  });
</script>
